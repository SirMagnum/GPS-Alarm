<?xml version="1.0" encoding="utf-8"?>
<!-- Map pin whose head is an alarm clock. Geometry stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.12"
        android:scaleY="1.12">

    <!-- Geofence radius ring under the tip -->
    <path
        android:pathData="M42,79.5 A12,3.5 0 1,0 66,79.5 A12,3.5 0 1,0 42,79.5 Z"
        android:strokeColor="#80F2A340"
        android:strokeWidth="1.6" />

    <!-- Alarm bells -->
    <group
        android:pivotX="54"
        android:pivotY="47"
        android:rotation="-42">
        <path
            android:fillColor="@color/logo_bell"
            android:pathData="M49.5,29 A4.5,4.5 0 0,1 58.5,29 Z" />
    </group>
    <group
        android:pivotX="54"
        android:pivotY="47"
        android:rotation="42">
        <path
            android:fillColor="@color/logo_bell"
            android:pathData="M49.5,29 A4.5,4.5 0 0,1 58.5,29 Z" />
    </group>

    <!-- Pin body -->
    <path
        android:fillColor="@color/logo_pin"
        android:pathData="M54,79 L39.6,56.03 A17,17 0 1,1 68.4,56.03 Z" />

    <!-- Clock face -->
    <path
        android:fillColor="@color/logo_face"
        android:pathData="M42,47 A12,12 0 1,0 66,47 A12,12 0 1,0 42,47 Z" />

    <!-- Hands -->
    <path
        android:pathData="M54,47 L54,38.5"
        android:strokeColor="@color/logo_hands"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />
    <path
        android:pathData="M54,47 L58.76,44.25"
        android:strokeColor="@color/logo_hands"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />
    <path
        android:fillColor="@color/logo_hands"
        android:pathData="M52.4,47 A1.6,1.6 0 1,0 55.6,47 A1.6,1.6 0 1,0 52.4,47 Z" />

    </group>
</vector>
